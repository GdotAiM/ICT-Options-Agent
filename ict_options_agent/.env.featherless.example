# ── Featherless OAuth ───────────────────────────────────────────────────────
FEATHERLESS_CLIENT_ID=YOUR_CLIENT_ID
FEATHERLESS_CLIENT_SECRET=your_server_side_secret_only
FEATHERLESS_REDIRECT_URI=http://localhost:8000/callback
FEATHERLESS_SCOPES=read write

# ── Auth Proxy Configuration ───────────────────────────────────────────────
AUTH_HOST=0.0.0.0
AUTH_PORT=8000
AUTH_RELOAD=false
